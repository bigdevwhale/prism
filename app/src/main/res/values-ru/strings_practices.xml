    <!-- The Mountain -->
    <string name="sos_stop_title">Стоп</string>
    <string name="sos_stop_text">Не отвечай пока. Всё, что ты скажешь в ближайшую минуту, скажет за тебя злость. Закрой рот, отложи телефон, сделай шаг назад.</string>
    <string name="sos_breathe_title">Дыши</string>
    <string name="sos_breathe_text">Вдох на четыре счёта, задержка на семь, выдох на восемь. Три раза.</string>
    <string name="sos_in">Вдох</string>
    <string name="sos_hold">Задержка</string>
    <string name="sos_out">Выдох</string>
    <string name="sos_cycle">Цикл %1$d из 3</string>
    <string name="sos_ground_title">Почувствуй опору</string>
    <string name="sos_ground_text">Ты — гора. Над ней проходит непогода, а гора остаётся.</string>
    <string-array name="sos_ground_steps">
        <item>Упрись обеими ступнями в пол и почувствуй, как он тебя держит.</item>
        <item>Назови три вещи, которые видишь прямо сейчас.</item>
        <item>Разожми челюсти и раскрой ладони.</item>
        <item>Опусти плечи подальше от ушей.</item>
    </string-array>
    <string name="sos_exit_title">Выйди из сцены достойно</string>
    <string name="sos_exit_text">Выйти из сцены — не значит проиграть. Выбери фразу, с которой уйдёшь.</string>
    <string-array name="sos_exit_lines">
        <item>Мне нужно десять минут. Я вернусь, и мы договорим.</item>
        <item>Для меня это важно, поэтому я хочу говорить спокойно. Дай мне минуту.</item>
        <item>Я сейчас слишком {злой|злая}, чтобы сказать что-то толковое. Давай вернёмся к этому через час.</item>
        <item>Я тебя слышу. Мне нужно подумать, прежде чем ответить.</item>
        <item>Давай пока остановимся. Я ухожу не от тебя, а от крика.</item>
    </string-array>
    <string name="sos_return_title">{Каким|Какой} ты вернёшься?</string>
    <string name="sos_return_text">Когда волна схлынет, выбери роль, в которой вернёшься в сцену.</string>
    <string name="sos_returned_title">Гора устояла</string>
    <string name="sos_returned_text">Ты возвращаешься в роли «%1$s».</string>
    <string name="sos_your_line">Твоя фраза</string>
    <string name="sos_threshold">Порог: %1$s</string>

    <!-- Rehearsal -->
    <string name="reh_intro">Трудный разговор идёт легче, если однажды ты уже {прошёл|прошла} его — в той роли, в которой хочешь быть.</string>
    <string name="reh_untitled">Разговор</string>
    <string name="reh_title">О чём разговор</string>
    <string name="reh_title_hint">Попросить у начальника прибавку</string>
    <string name="reh_role">Роль</string>
    <string name="reh_when">Когда</string>
    <string name="reh_when_none">Не выбрано</string>
    <string name="reh_goal">Чего я хочу от разговора</string>
    <string name="reh_goal_hint">Договориться о сроках так, чтобы никто не ушёл в оборону</string>
    <string name="reh_say">Три фразы, которые я скажу</string>
    <string name="reh_say_hint">По одной на строку</string>
    <string name="reh_not_say">Одна фраза, которую я не скажу</string>
    <string name="reh_not_say_hint">Тот колкий ответ, после которого всё пойдёт не так</string>
    <string name="reh_exit">Если пойдёт плохо, я выйду из разговора так</string>
    <string name="reh_exit_hint">Давай сделаем перерыв и вернёмся к этому завтра.</string>
    <string name="reh_visualise">Прожить заранее</string>
    <string name="reh_after">После разговора</string>
    <string name="reh_outcome">Как всё прошло?</string>
    <string name="reh_outcome_hint">Что случилось, что сработало, что сделаешь иначе</string>
    <string name="reh_score">Насколько получилось быть в роли: %1$d</string>
    <string name="reh_mark_done">Разговор состоялся</string>
    <string name="reh_delete_title">Удалить репетицию?</string>
    <string name="reh_delete_text">Все записи к этому разговору пропадут.</string>

    <string name="vis_1_t">Место</string>
    <string name="vis_1">Закрой глаза. Где это происходит? Представь комнату, свет, где ты сидишь или стоишь.</string>
    <string name="vis_2_t">Человек</string>
    <string name="vis_2">Представь его перед собой: лицо, сегодняшнее настроение. Вспомни, чего ты хочешь от разговора.</string>
    <string name="vis_3_t">Тело</string>
    <string name="vis_3">Прежде чем заговорить, войди в роль «%1$s». Выпрямись, замедли дыхание, расслабь лицо.</string>
    <string name="vis_4_t">Первая фраза</string>
    <string name="vis_4">Услышь, как говоришь её спокойно, без спешки.</string>
    <string name="vis_5_t">Становится трудно</string>
    <string name="vis_5">Тебе возражают или говорят что-то обидное. Почувствуй это и останься в роли. Если нужно, выйди из разговора своей фразой.</string>
    <string name="vis_6_t">Всё заканчивается хорошо</string>
    <string name="vis_6">Представь финал: ты {сказал|сказала} то, что важно, и {остался|осталась} собой. Заметь, каково это.</string>

    <!-- Council -->
    <string name="cnc_intro">Каждая роль видит вопрос со своей стороны. Выслушай всех, а решение пусть примет ядро.</string>
    <string name="cnc_question">Вопрос</string>
    <string name="cnc_question_hint">Соглашаться ли на работу в другом городе?</string>
    <string name="cnc_pick">Кто входит в совет (выбери от %1$d до %2$d)</string>
    <string name="cnc_says">Что говорит %1$s?</string>
    <string name="cnc_says_hint">Говори её голосом</string>
    <string name="cnc_core_q">А что скажет ядро?</string>
    <string name="cnc_core">Ядро</string>
    <string name="cnc_core_hint">Какие ценности здесь важнее всего и что они подсказывают?</string>
    <string name="cnc_decision">Решение</string>
    <string name="cnc_decision_hint">Что я решаю и какой первый шаг</string>

