    <!-- Core -->
    <string name="core_title">Core</string>
    <string name="core_lead">The core is the white light. Whatever role you\'re in, at home or at work, calm or furious, these values stay the same.</string>
    <string name="core_hint">Keep only what you\'d stand by on your worst day. One to seven values.</string>
