<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Onboarding -->
    <string name="ob_welcome_title">One light, many colours</string>
    <string name="ob_welcome_text">Your values are the light. Your roles are the colours it splits into: at home, at work, with friends, when you\'re angry.</string>
    <string name="ob_welcome_more">Prism helps you write who you want to be in each of them, and be that person more often.</string>
    <string name="ob_start">Begin</string>
    <string name="ob_name_title">What should I call you?</string>
    <string name="ob_name_text">Only for greetings. It never leaves your phone.</string>
    <string name="ob_name_hint">Your name</string>
    <string name="ob_gender_title">How should I address you?</string>
    <string name="gender_male">He</string>
    <string name="gender_female">She</string>
    <string name="ob_core_title">Your core</string>
    <string name="ob_core_text">Pick three to five values that should shine through every role you play.</string>
    <string name="ob_core_custom">Your own value</string>
    <string name="ob_core_count">%1$d of 5</string>
    <string name="ob_spheres_title">Your spheres</string>
    <string name="ob_spheres_text">Where are you a different person? Pick the parts of life you want to work with.</string>
    <string name="ob_spheres_note">You can add your own spheres later on the Roles tab: a dog, a band, a garden.</string>
    <string name="ob_finish_title">The prism is ready</string>
    <string name="ob_finish_text">Now it needs colours. Start with a few good roles from the library, or write your own.</string>
    <string name="ob_finish_library">Pick roles from the library</string>
    <string name="ob_finish_look">Look around first</string>

